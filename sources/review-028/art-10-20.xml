<artikel bwb-ng-variabel-deel="/Hoofdstuk10/Titeldeel10.1/Afdeling10.1.2/Artikel10:20" stam-id="2872543" versie-id="4420252" id="C37811151" label-id="2820534" inwerking="1998-01-01" label="Artikel 10:20" bron="Stb.1996-333" effect="nieuw" ondertekening_bron="1996-06-20" publicatie_bron="1996-07-04" publicatie_iwt="1997-12-18" status="goed">
