<artikel bwb-ng-variabel-deel="/Hoofdstuk10/Titeldeel10.1/Afdeling10.1.3/Artikel10:22" code="n1-10.22" stam-id="10090973" versie-id="16488832" id="C23114151" label-id="10067184" inwerking="2009-07-01" label="Artikel 10:22" bron="Stb.2009-264" effect="nieuw" ondertekening_bron="2009-06-25" publicatie_bron="2009-06-30" publicatie_iwt="2009-06-30" status="goed">
