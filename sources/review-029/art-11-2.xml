<artikel bwb-ng-variabel-deel="/Hoofdstuk11/Artikel11:2" stam-id="2868823" versie-id="30727712" id="C44097601" label-id="2820834" inwerking="2025-07-01" label="Artikel 11:2" bron="Stb.2025-124" effect="wijziging" ondertekening_bron="2025-04-23" publicatie_bron="2025-05-14" publicatie_iwt="2025-06-12" status="goed">
