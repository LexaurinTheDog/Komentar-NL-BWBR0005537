        <li bwb-ng-variabel-deel="/Bijlage2/Divisie2/Artikel4/Opsomming_1/Onderdeela">
          <li.nr>a.</li.nr>
          <al>een besluit op grond van de <extref doc="jci1.3:c:BWBR0045754" label-id="16045964" verwijzing-id="3152210" bwb-id="BWBR0045754">Wet open overheid</extref></al>
        <meta-data><jcis><jci versie="1.3" verwijzing="jci1.3:c:BWBR0005537&amp;bijlage=2&amp;hoofdstuk=2&amp;artikel=4&amp;o=a&amp;z=2026-08-15&amp;g=2026-08-15" onderdeel="o=a" /></jcis></meta-data></li>
        <li bwb-ng-variabel-deel="/Bijlage2/Divisie2/Artikel4/Opsomming_1/Onderdeelb">
